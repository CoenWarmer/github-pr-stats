# GitHub Personal Access Token
# Get yours at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=

# Optional: Buildkite Integration
# For CI/CD pipeline visualization
BUILDKITE_TOKEN=
BUILDKITE_ORG_SLUG=

# Optional: Elasticsearch Integration
# For indexing and storing PR stats
ES_NODE=https://your-elasticsearch-cluster:9200
ES_API_KEY=your_elasticsearch_api_key
ES_INDEX_NAME=github-pr-stats

NEXT_PUBLIC_NAV_BAR_LINK=
NEXT_PUBLIC_NAV_BAR_TEXT=

# Optional: Logging Configuration
# Options: error, warn, info, debug
LOG_LEVEL=info

