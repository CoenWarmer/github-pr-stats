# Server Configuration
PORT=3000
SERVICE_NAME=cicd-otel-pipeline
ENVIRONMENT=development

# OpenTelemetry Configuration
# For Elastic APM Serverless, use the standard OpenTelemetry environment variables
# Option 1: Use base endpoint (SDK will append /v1/traces automatically)
OTEL_EXPORTER_OTLP_ENDPOINT=https://cfe3e17a997f46b5b1ad9bfe4091a863.ingest.europe-west1.gcp.elastic.cloud:443
# Option 2: Or use traces-specific endpoint with full path (recommended for Elastic)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cfe3e17a997f46b5b1ad9bfe4091a863.ingest.europe-west1.gcp.elastic.cloud:443/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey YOUR_OTLP_API_KEY_HERE
OTEL_RESOURCE_ATTRIBUTES=service.name=cicd-otel-pipeline,service.version=1.0.0,deployment.environment=production

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Buildkite Configuration
BUILDKITE_WEBHOOK_TOKEN=your_buildkite_webhook_token_here
BUILDKITE_API_TOKEN=your_buildkite_api_token_here
BUILDKITE_ORGANIZATION=elastic

# Elasticsearch Configuration (shared with pr-stats-app)
# Uses API key authentication for Elasticsearch Serverless
ES_NODE=https://your-serverless.es.region.aws.found.io:443
ES_API_KEY=your_api_key_here
ES_INDEX_NAME=github-pr-stats

